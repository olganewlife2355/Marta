# Скопіюйте цей файл у .env і вставте свій ключ з console.anthropic.com
ANTHROPIC_API_KEY=
# Модель для скорингу (за замовчуванням claude-opus-5-5). Дешевший варіант: claude-sonnet-5-5
SOURCING_MODEL=claude-opus-5-5
# Контекст компанії для промптів
SOURCING_COMPANY_CONTEXT=StellarTech: B2C mobile subscription apps, edtech, publisher з performance marketing.
